    "build_type": "Release"
  },

  "random_seeds": {
    "global": 42,
    "minimax": 42,
    "random": 12345,
    "mcts": 42
  },

  "expected_results": {
    "minimax_win_rate": ">=0.90",
    "confidence_interval": "95%",
    "p_value_threshold": "<0.05"
